{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install (uv)",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_PYTHON_INSTALL_DIR": "${workspaceFolder}/backend/.python",
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/backend/.venv"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "backend: run FastAPI",
      "type": "shell",
      "command": "uv run python run.py",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_PYTHON_INSTALL_DIR": "${workspaceFolder}/backend/.python",
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/backend/.venv"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "frontend: install (npm)",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
