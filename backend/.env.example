# StockPulse Backend Environment Configuration Example
PROJECT_NAME=StockPulse
DATABASE_URL=sqlite:///./stockpulse.db

# LLM Gateway Configuration (LiteLLM OpenAI-Compatible Endpoint)
LLM_API_KEY=your_litellm_api_key_here
LLM_BASE_URL=https://litellm-qc.zycus.net/v1
LLM_MODEL=qwen-cursor
LLM_PRODUCT=PC1
LLM_TIMEOUT_SECONDS=15.0

# Strategy & Guardrail Thresholds
ACTIVE_STRATEGY=ai
DEMAND_SPIKE_MULTIPLIER=3.0
PRICE_MAX_MULTIPLIER=3.0
PRICE_MIN_MULTIPLIER=0.3

# CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
